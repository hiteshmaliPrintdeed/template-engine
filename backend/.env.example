# =============================================================================
# Pixovo backend — environment variables
# =============================================================================
#
# Copy to `backend/.env` and edit. Every variable here is OPTIONAL: the value
# shown is the built-in default, so an empty (or absent) .env runs the app
# exactly as it runs today.
#
#   cp backend/.env.example backend/.env
#
# WHERE THIS FILE MUST LIVE: `backend/.env`. app/config.py looks for
# `backend/.env` first and falls back to `BASE_DIR.parent.parent/.env` — which
# resolves to the directory ABOVE the repository, not the repo root. So a `.env`
# placed at the repo root is NOT read. Keep it in backend/.
#
# Values are read once, at import time. Restart the server after editing.
# Booleans accept 1/true/yes/on. Sizes are in bytes, durations in seconds.
# =============================================================================


# -----------------------------------------------------------------------------
# Server binding and CORS
# -----------------------------------------------------------------------------
# Read by run.py. Behind a reverse proxy set PIXOVO_HOST=127.0.0.1 so the app is
# unreachable except through that proxy. PIXOVO_RELOAD is the uvicorn dev
# watcher: leave it 0 in production, where it would spawn a second process and
# restart the app every time the SQLite WAL or the uploads dir changes.
PIXOVO_HOST=0.0.0.0
PIXOVO_PORT=8000
PIXOVO_RELOAD=0

# Comma-separated EXACT origins allowed to call this API from a browser.
# Empty falls back to the local dev origins (localhost:5173, :3000, 127.0.0.1:5173).
#
# No wildcard is accepted, by design: "*" here previously sat alongside
# credentialed CORS, which makes Starlette trust every origin on the internet.
#
# In the recommended deployment this list barely matters -- one reverse proxy
# serves the SPA and maps /api, /uploads and /exports to this app, so the
# browser only ever sees one origin and never issues a preflight. It governs
# direct calls to the API subdomain.
#   PIXOVO_ALLOWED_ORIGINS=https://storymode.pixovo.com,https://apistorymode.pixovo.com
PIXOVO_ALLOWED_ORIGINS=


# -----------------------------------------------------------------------------
# Logging (local development)
# -----------------------------------------------------------------------------
# PIXOVO_QUIET_LOGS=1 keeps the terminal readable for print() debugging: the
# console shows only WARNING and ERROR, uvicorn's per-request access log (the
# /api/jobs polling flood) is silenced. Log files under backend/logs/ keep full
# DEBUG detail either way. MediaPipe's three native startup lines still print:
# they come from C++ and bypass Python logging.
# Restart the server after changing it: --reload watches .py files, not .env.
PIXOVO_QUIET_LOGS=

# Finer control over the console only: TRACE | DEBUG | INFO | SUCCESS | WARNING
# | ERROR | CRITICAL | OFF. Takes precedence over PIXOVO_QUIET_LOGS. OFF removes
# console logging entirely (files are still written). Empty = default.
PIXOVO_LOG_CONSOLE_LEVEL=


# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
# Optional. Without it the story/theme engine runs in rule-based offline mode,
# which is a supported path rather than a degraded one. Setting it is the only
# switch: there is no separate enable flag.
GEMINI_API_KEY=

# Per-request HTTP timeouts in seconds, enforced by the Gemini SDK itself. The
# book call backs the interactive chat widget; the chapter call runs inside the
# async generate job and asks for more output. On timeout the engine falls back
# to offline content -- and remembers that for the session and prompt, so an
# outage costs one timeout per session rather than one per request.
PIXOVO_GEMINI_TIMEOUT_SEC=8
PIXOVO_GEMINI_CHAPTER_TIMEOUT_SEC=20

# Per-chapter captions: a title and caption pool for each story segment (a run
# of photos between time gaps or location changes), in one extra Gemini call per
# generation. Off keeps one caption pool per variation for the whole book. No
# effect without GEMINI_API_KEY.
PIXOVO_CHAPTER_CAPTIONS=1


# -----------------------------------------------------------------------------
# Storage backend
# -----------------------------------------------------------------------------
# local | s3. Anything else refuses to start.
#
# `local` keeps every photo byte on this machine's disk and serves it from the
# /uploads static mount — the original behaviour.
#
# `s3` requires PIXOVO_S3_BUCKET and PIXOVO_S3_REGION below. A misconfigured s3
# setup CRASHES AT BOOT rather than falling back to local disk: url_for()
# returns the same "/uploads/{key}" string in both modes, so a silent fallback
# would be invisible in the logs, the database and the UI, and would surface
# only as a customer's paid print returning 404.
PIXOVO_STORAGE=local

# Browser-direct uploads. Off even in s3 mode until you opt in, so the two
# halves of the migration roll out — and roll back — independently.
#
# 0: full-resolution originals POST to /api/upload-originals and the server
#    streams them to storage. Size and quota limits are enforced mid-copy.
# 1: the browser uploads originals straight to the bucket with a presigned POST.
#    The server never sees the bytes; it verifies them with head_object at
#    /api/uploads/confirm.
#
# Setting this back to 0 is an instant, total rollback that needs no frontend
# deploy — the client asks the server how to upload on every single file.
PIXOVO_DIRECT_UPLOAD=0


# -----------------------------------------------------------------------------
# S3 (only read when PIXOVO_STORAGE=s3)
# -----------------------------------------------------------------------------
# See docs/S3_SETUP.md for the bucket CORS policy, the mandatory lifecycle
# rules, and the IAM policy. Direct upload does NOT work without bucket CORS.
PIXOVO_S3_BUCKET=
PIXOVO_S3_REGION=

# Set for MinIO / Cloudflare R2 / any S3-compatible endpoint. Leave empty for
# real AWS. Setting it also switches the client to path-style addressing, which
# those gateways need because they have no wildcard DNS.
PIXOVO_S3_ENDPOINT_URL=

# Key prefix, so dev/staging/prod can share one bucket without colliding.
# e.g. "staging" -> staging/originals/{session}/{photo}_orig.jpg
# NOT stored in the database: photos.original_key holds the unprefixed key, so
# this can change without a data migration.
PIXOVO_S3_KEY_PREFIX=

# post | put.
#
# Keep `post`. Only a POST policy can carry a content-length-range condition,
# which is what makes S3 refuse an oversize body before accepting it. A
# presigned PUT's Content-Length is supplied by the client, so signing it
# enforces nothing and the confirm-time head_object becomes the only defence.
#
# Use `put` only if your provider's presigned-POST support is incomplete
# (historically true of R2; MinIO supports both).
PIXOVO_S3_PRESIGN_MODE=post

# Upload URL lifetime. Long enough to start and finish a 20MB upload on a poor
# connection; short enough that a leaked URL is near worthless. Note an expiring
# signature does NOT kill an upload already in flight — S3 validates it when the
# request headers arrive.
PIXOVO_S3_PRESIGN_TTL=900

# Read URL lifetime, used by the /uploads redirect. The redirect is cached for
# half this value so a cached redirect can never outlive its own signature.
PIXOVO_S3_MEDIA_GET_TTL=3600

# Server-side encryption: AES256, or aws:kms with a key id.
PIXOVO_S3_SSE=
PIXOVO_S3_SSE_KMS_KEY_ID=

# e.g. INTELLIGENT_TIERING. Empty uses the bucket default.
PIXOVO_S3_STORAGE_CLASS=

# boto3 connection pool. The library default of 10 silently queues requests on
# the urllib3 pool during ingest fan-out. Default here: max(32, workers * 4).
PIXOVO_S3_MAX_POOL=

# head_bucket + clock-skew probe + CORS report at boot. Keep this on: it turns
# bad credentials, a wrong region, >300s of clock skew (which breaks every
# sigv4 signature) and a missing CORS policy into a startup failure or a loud
# warning, instead of an upload error a user hits later.
PIXOVO_S3_STARTUP_CHECK=1

# Credentials. In production prefer an IAM instance/task role and leave these
# empty — boto3's default chain picks the role up automatically. Presigning
# performs no API call and needs no extra permission, but the resulting URL
# INHERITS THE SIGNER'S PERMISSIONS, so scope the role to this bucket+prefix.
# Set these only for local MinIO or a dev key pair.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
# Defaults are backend/app/uploads and backend/app/exports. Overridden by the
# test suite so it never writes into the real tree.
PIXOVO_UPLOADS_DIR=
PIXOVO_EXPORTS_DIR=

# SQLite file. Default: backend/pixovo_session.db
PIXOVO_DB_PATH=

# Scratch: staging for bytes in transit, plus the local cache of objects pulled
# back from remote storage. Default: backend/.scratch (gitignored).
#
# In s3 mode this is the only thing that can still fill the disk — a 40-spread
# PDF export downloads every placed original — and the storage budget below is
# a database counter that cannot see these files. Hence the three limits.
PIXOVO_SCRATCH_DIR=
PIXOVO_SCRATCH_MAX_BYTES=8589934592     # 8 GiB  — cache byte budget (LRU evicts)
PIXOVO_SCRATCH_TTL_SECONDS=3600         # 1 hour — cache entry age limit
PIXOVO_SCRATCH_MIN_FREE_BYTES=5368709120 # 5 GiB — hard free-space floor


# -----------------------------------------------------------------------------
# Ingestion limits
# -----------------------------------------------------------------------------
# Hard ceiling per session, enforced at POST /api/sessions so an oversized batch
# is rejected before any bytes move.
MAX_PHOTOS_PER_SESSION=1000

# Thumbnails per ingest chunk. Served to the client so the two sides cannot
# drift. 40 x ~35KB is a ~1.5MB request.
INGEST_CHUNK_SIZE=40

# Per-photo ceiling for full-resolution originals.
MAX_FILE_SIZE=20971520                  # 20 MiB

# Per-session storage ceiling, tracked as a running counter on
# sessions.total_bytes (never a filesystem walk).
MAX_BYTES_PER_SESSION=3221225472        # 3 GiB

# Global ceiling across all sessions, checked at session creation -> HTTP 503.
# Always was a database counter, so it is storage-agnostic; under s3 it is a
# billing guard rather than a disk guard and can be raised considerably.
GLOBAL_STORAGE_BUDGET=64424509440       # 60 GiB

# Deprecated alias for the above, read only when GLOBAL_STORAGE_BUDGET is unset.
# Kept so an existing .env written before the rename keeps working. Prefer the
# new name; setting both means this one is ignored.
# GLOBAL_DISK_WATERMARK=64424509440

# Per-session presign rate limit, per minute. The real abuse control; the
# lifetime ceiling (MAX_PHOTOS_PER_SESSION x 10) only stops a slow drip.
PIXOVO_PRESIGN_RATE_PER_MIN=120


# -----------------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------------
# Defaults are derived from the host's core count:
#   PIXOVO_FILTER_WORKERS   = max(2, cores - 1)   (one core left for the loop)
#   PIXOVO_JOB_CONCURRENCY  = max(2, cores // 2)
# Leave empty unless you are tuning. A saturated filter pool starves request
# handling, and the symptom looks like a network problem rather than CPU
# exhaustion.
PIXOVO_FILTER_WORKERS=
PIXOVO_JOB_CONCURRENCY=

# thread | process. Settled by measurement: OpenCV releases the GIL, PIL and
# imagehash largely do not.
PIXOVO_POOL=thread

# Bounded in-memory caches over the SQLite source of truth. Every read path
# falls back to the database on a miss, so eviction is correct, merely slower.
PIXOVO_PHOTO_CACHE=8000
PIXOVO_JOB_CACHE=500
PIXOVO_CACHE_TTL=3600


# -----------------------------------------------------------------------------
# Not used by the API server
# -----------------------------------------------------------------------------
# PORT is read ONLY by the standalone face-detector demo at
# app/engine/filter/face_detector/app.py. The main backend's port is set in
# run.py (8000) or on the uvicorn command line.
# PORT=8000
