# =============================================================================
# Pixovo frontend — environment variables
# =============================================================================
#
# Copy to `frontend/.env` and edit. Every variable is OPTIONAL: the value shown
# is the built-in default, so an absent .env behaves exactly as before.
#
#   cp frontend/.env.example frontend/.env
#
# Read by vite.config.js at dev-server start. Restart `npm run dev` after
# editing — Vite does not hot-reload its own config's env values.
#
# NOTE ON THE VITE_ PREFIX
# ------------------------
# None of these carry the VITE_ prefix, and that is deliberate. Vite injects
# VITE_-prefixed variables into the CLIENT BUNDLE, where anyone can read them.
# These configure the dev server in Node only. Never put a secret in a VITE_
# variable: it ends up in the JavaScript you ship.
# =============================================================================


# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Where the dev server proxies /api, /uploads and /exports.
#
# The app calls the API with RELATIVE paths, so this proxy is the only thing
# connecting the two in development. Point it at a different port to run against
# a second backend without touching any source file.
PIXOVO_BACKEND_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# Dev server
# -----------------------------------------------------------------------------
PIXOVO_DEV_PORT=5173

# Comma-separated hostnames Vite will serve. Needed for tunnels: a free ngrok
# subdomain changes on every restart, so the wildcard entries matter.
# Default: doorpost-smashing-regime.ngrok-free.dev,.ngrok-free.dev,.ngrok.io,localhost
PIXOVO_DEV_ALLOWED_HOSTS=

# Comma-separated origins for the dev server's own CORS headers.
# Default: the ngrok host plus http://localhost:<port> and http://127.0.0.1:<port>
PIXOVO_DEV_CORS_ORIGINS=


# =============================================================================
# PRODUCTION PREVIEW (`npm run preview`, serving the built dist/)
# =============================================================================
#
# `vite preview` does NOT read server.proxy -- and does not need to. In
# production the reverse proxy in front owns the routing of /api, /uploads and
# /exports to the backend, so preview only ever serves static assets.
#
# Bind to loopback: nothing should reach preview except that proxy.
PIXOVO_PREVIEW_PORT=4173
PIXOVO_PREVIEW_HOST=127.0.0.1

# Preview applies the same Host-header check as the dev server. Without the
# deployed domain listed here every proxied request comes back "Blocked request".
# Comma-separated; empty means storymode.pixovo.com, localhost, 127.0.0.1.
PIXOVO_PREVIEW_ALLOWED_HOSTS=


# =============================================================================
# NOT CONFIGURABLE YET — worth knowing
# =============================================================================
#
# There is deliberately no VITE_API_BASE_URL. Every fetch in src/ uses a
# relative path ('/api/sessions', '/uploads/...'), which the dev proxy above
# resolves. A production build has NO proxy, so the built assets must be served
# from the same origin as the backend, or behind a reverse proxy mapping /api,
# /uploads and /exports to it.
#
# Deploying the frontend to a DIFFERENT origin than the API would need an API
# base threaded through roughly a dozen fetch call sites across five files —
# a real change rather than a config flag. Adding a variable here that nothing
# reads would be worse than having none, so it is left out until that work is
# done.
#
# The S3 bucket is never contacted using anything from this file. Upload URLs
# are minted per request by the backend (POST /api/uploads/presign), so no
# bucket name, region or credential ever reaches the browser as configuration.
# =============================================================================
